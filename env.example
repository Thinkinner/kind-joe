# Better Auth (required in production: BETTER_AUTH_SECRET min 32 chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: admin subdomain (same Next.js app)
# ADMIN_DASHBOARD_HOST=admin.kindjoe.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.kindjoe.com

# Optional: shared session cookie across subdomains (e.g. .kindjoe.com)
# BETTER_AUTH_COOKIE_DOMAIN=.kindjoe.com

# Already used for the public site; included in Better Auth trusted origins
# NEXT_PUBLIC_SITE_URL=https://www.kindjoe.com
