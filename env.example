# =============================================================================
# Kind Joe — environment template
# Copy to `.env` or `.env.local` and fill in values. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Core URLs (production: set to your real domains, no trailing slash)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (required for auth, articles, Drizzle)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# -----------------------------------------------------------------------------
# Auth hardening (optional — omit in dev/CI to use no-op / disabled paths)
# -----------------------------------------------------------------------------
# Upstash Redis REST (rate limits on POST /api/auth)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (sensitive auth POSTs when secret is set)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Better Auth (required in production)
# -----------------------------------------------------------------------------
# Min 32 characters; generate a random string for production
BETTER_AUTH_SECRET=
# Canonical origin for auth callbacks (usually same as NEXT_PUBLIC_SITE_URL)
BETTER_AUTH_URL=http://localhost:3000
# Optional: shared cookie across subdomains, e.g. .kindjoe.com
# BETTER_AUTH_COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Email — Resend (sign-in codes, password reset emails)
# -----------------------------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "Kind Joe <mail@yourdomain.com>"
# Dev: can use Kind Joe <onboarding@resend.dev> with Resend test limits
EMAIL_FROM=

# -----------------------------------------------------------------------------
# Optional: separate admin hostname / URL (middleware + trusted origins)
# -----------------------------------------------------------------------------
# ADMIN_DASHBOARD_HOST=admin.kindjoe.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.kindjoe.com

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Admin / internal API (optional — used by some public pages)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ADMIN_API=
# NEXT_PUBLIC_ADMIN_API_URL=

# -----------------------------------------------------------------------------
# Pusher (Kind Joe Watch / live features — server + client)
# -----------------------------------------------------------------------------
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# -----------------------------------------------------------------------------
# AI / Google GenAI (aggregators, signals)
# -----------------------------------------------------------------------------
# GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Stocks (optional)
# -----------------------------------------------------------------------------
# FINNHUB_API_KEY=

# -----------------------------------------------------------------------------
# Social / X (optional)
# -----------------------------------------------------------------------------
# X_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# GoHighLevel (newsletter, leads, Ventura subscriber, reader signup sync — optional)
# -----------------------------------------------------------------------------
# GOHIGHLEVEL_API_KEY=
# Optional tag on new reader contacts (default: Kind Joe Reader)
# GOHIGHLEVEL_READER_TAG=Kind Joe Reader
# Reader signups merge into existing GHL contacts (adds tags) when email already exists.
# Visiting /kindjoe-watch sets httpOnly cookie → next reader signup adds GHL tag "kindjoe-watch".
# VC_GOHIGHLEVEL_API_KEY=

# -----------------------------------------------------------------------------
# Slack — contact support bot (optional)
# -----------------------------------------------------------------------------
# KJ_SUPPORT_SLACK_BOT_TOKEN=
# KJ_SUPPORT_SLACK_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Webhooks & cron (optional — protect with secrets in production)
# -----------------------------------------------------------------------------
# CRON_SECRET=
# DISCORD_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_SECRET=
# RSS_INTEL_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Signals / publishing (optional)
# -----------------------------------------------------------------------------
# SIGNAL_ARTICLE_AUTHOR_ID=

# =============================================================================
# Staff sign-in is not linked from the public reader login page.
# Open /admin/login directly (or your ADMIN_DASHBOARD_HOST) when deploying admin.
# Password reset for email/password accounts: /forgot-password (share URL privately).
# =============================================================================
