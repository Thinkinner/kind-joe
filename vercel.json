{
  "crons": [
    {
      "path": "/api/internal/rss-auto-writer",
      "schedule": "0 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kindjoe.com" }],
      "destination": "https://www.kindjoe.com/:path*",
      "permanent": true
    }
  ]
}
